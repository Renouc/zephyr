{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "zephyr",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-03",
	"compatibility_flags": [
	  "nodejs_compat"
	],
	// "vars": {
	//   "MY_VAR": "my-variable"
