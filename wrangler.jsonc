	// ],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "recipe",
			"database_id": "95cdd8d6-9935-48fc-b312-2ed601c9aa59",
			"remote": false
		}
	],
	// "ai": {
	//   "binding": "AI"
	// },
	"observability": {
	  "enabled": true,
	  "head_sampling_rate": 1
	}
}